{
  "name": "@chain/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsc -p tsconfig.json && vitest run",
    "test:anvil": "vitest run -c vitest.anvil.config.ts",
    "start": "ponder start --schema ${PONDER_LIVE_SCHEMA:-live_1} --views-schema ${PONDER_SCHEMA:-indexer}",
    "worker": "node dist/worker/main.js",
    "replay": "node dist/replay/nightly.js",
    "codegen": "ponder codegen",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@chain/abi": "workspace:*",
    "@chain/shared": "workspace:*",
    "hono": "^4.13.9",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "ponder": "0.17.12",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "exports": {
    "./alerts": {
      "types": "./dist/worker/notifier.d.ts",
      "default": "./dist/worker/notifier.js"
    },
    "./invariants": {
      "types": "./dist/core/invariants.d.ts",
      "default": "./dist/core/invariants.js"
    },
    "./calendar": {
      "types": "./dist/worker/calendar.d.ts",
      "default": "./dist/worker/calendar.js"
    },
    "./projection": {
      "types": "./dist/worker/projection.d.ts",
      "default": "./dist/worker/projection.js"
    },
    "./ops": {
      "types": "./dist/worker/main.d.ts",
      "default": "./dist/worker/main.js"
    }
  }
}
