# Copy to .env (gitignored). Never commit keys or keyed RPC URLs (CLAUDE.md §9).
# Shared by `ponder start`, the worker and the nightly replay.
DATABASE_URL=postgres://chain:chain@127.0.0.1:5432/indexer
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org          # production: a keyed provider URL, from the secret store
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
FACTORY_START_BLOCK=0                     # the factory's deployment block
POLLING_INTERVAL_MS=1000

# Worker
PONDER_SCHEMA=indexer                     # the views schema (`ponder start --views-schema indexer`)
PROPERTIES_FILE=../quote-service/properties.json   # same file as the quote service (resource time zones)
POLL_MS=2000
MONITOR_EVERY_MS=60000
RECEIVED_CONFIRMATIONS=2                  # spec 10.2: unsafe + 2
MAX_LAG_BLOCKS=60                         # page when the projection is this far behind latest

# Nightly replay
PONDER_LIVE_SCHEMA=live_1                 # the schema the running `ponder start --schema` writes
PONDER_HOST=127.0.0.1                     # read API bind address; loopback by default. Set a private interface, never a public one: /status and /metrics have no auth

# Read API (review 0005 R6): bearer token, >= 32 chars; the quote service sends the same value.
INDEXER_API_TOKEN=
