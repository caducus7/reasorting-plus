# Copy to .env (gitignored). Never commit keys (CLAUDE.md §9).
DATABASE_URL=postgres://chain:chain@127.0.0.1:5432/indexer   # the indexer's database (C6 views)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
PONDER_SCHEMA=indexer
ESCROWS=0x...                          # comma-separated; this key must be each escrow's rebalancer
DRY_RUN=true                           # the default; only "false" sends transactions
SIGNER=kms
KMS_KEY_ID=
AWS_REGION=
CYCLE_SEC=60
STUCK_AFTER_SEC=180
# Base Sepolia (MockYieldVault): mock liquidity and a fixed price. Base mainnet: aave + chainlink
# (addresses default to the verified ones in src/config.ts).
LIQUIDITY_SOURCE=mock-vault
PRICE_SOURCE=fixed
# Policy (spec 6.7 defaults)
MIN_MOVE_ATOMIC=500000000
DEPLOY_LIQUIDITY_X=20
EXIT_LIQUIDITY_X=5
PRICE_BAND_BPS=100
MAX_PRICE_AGE_SEC=90000
