# Copy to .env (gitignored). Never commit keys, keyed RPC URLs or KMS credentials (CLAUDE.md §9).
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://chain:chain@127.0.0.1:5432/quotes

# Chain. CHAIN_ID is checked against the RPC at boot; the escrow's EIP-712 domain and quoteSigner
# are checked too. Base Sepolia: 84532, https://sepolia.base.org. Local Anvil: 31337.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
ESCROW=
ESCROW_FROM_BLOCK=0                  # used only without INDEXER_URL
INDEXER_URL=http://127.0.0.1:42069  # C6 read API (docs/adr/0017 §8); unset = read bookings from the chain

# JSON array of properties (src/property.ts schema).
PROPERTIES_FILE=./properties.json

# Quote signer. kms (default) for every deployed environment; local is refused unless CHAIN_ID=31337.
SIGNER=kms
KMS_KEY_ID=
AWS_REGION=
# LOCAL_SIGNER_PK=  (Anvil only: anvil account 2 matches contracts/script/DeployLocal.s.sol)

# Guest JWT from the checkout backend (D7). Exactly one of the two key sources.
JWT_ISSUER=checkout
JWT_AUDIENCE=booking-api
JWT_PUBLIC_KEY_PEM=
JWT_JWKS_URL=

# Policy knobs (docs/adr/0012). Defaults shown.
OFFER_LOCK_SEC=1500
QUOTE_TTL_SEC=900
FEED_MAX_AGE_SEC=900
MAX_CLOCK_SKEW_SEC=120
APY_ESTIMATE_BPS=400
YIELD_PROTOCOL=Aave V3 USDC on Base
