# Copy to .env (gitignored). Never commit keys or feed URLs (CLAUDE.md §9).
DATABASE_URL=postgres://chain:chain@127.0.0.1:5432/indexer   # the indexer's database (C6 views + indexer_ops)
CHAIN_ID=84532
PONDER_SCHEMA=indexer
FEEDS_FILE=./feeds.json                  # secret: channel import URLs (see feeds.example.json)
PROPERTIES_FILE=../quote-service/properties.json
EXPORT_TOKEN_SECRET=                     # >= 32 random bytes, e.g. `openssl rand -base64 48`
PUBLIC_BASE_URL=https://ical.example.com
PORT=8090
POLL_INTERVAL_SEC=300
MAX_BACKOFF_SEC=3600
STALE_ALERT_SEC=900                      # keep equal to the quote service's FEED_MAX_AGE_SEC
MASS_REMOVAL_MIN=2                       # hold a removal of >= this many future blocks ...
MASS_REMOVAL_FRACTION=0.5                # ... that is more than this share of them (or empties the feed)
ALLOW_LOCAL_FEEDS=0                      # Anvil only
