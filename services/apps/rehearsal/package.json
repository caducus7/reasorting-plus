{
  "name": "@chain/rehearsal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deployment rehearsal on a local Anvil fork of Base Sepolia: real deploy scripts, real Sepolia USDC, every service as a process. Never broadcasts to a real chain.",
  "scripts": {
    "test": "tsc -p tsconfig.json && vitest run --dir test --exclude 'test/*.rehearsal.ts'",
    "rehearse": "vitest run -c vitest.rehearsal.config.ts"
  },
  "dependencies": {
    "@chain/abi": "workspace:*",
    "@chain/shared": "workspace:*",
    "@chain/signer": "workspace:*",
    "@noble/curves": "^2.4.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
